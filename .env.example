# Never expose this key in browser code.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Or use MiniMax for both text and speech.
# AI_PROVIDER=minimax
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 中国大陆低延迟 TTS 入口；海外部署可改回 https://api.minimaxi.com/v1
# MINIMAX_TTS_BASE_URL=https://api-bj.minimaxi.com/v1
# MiniMax-M3 使用 reasoning_split 隔离隐藏推理，避免思考文本进入朗读正文
# MINIMAX_TEXT_MODEL=MiniMax-M3
# MINIMAX_TTS_MODEL=speech-2.8-turbo
# MINIMAX_TTS_VOICE=female-tianmei
# MINIMAX_TTS_VOICE=male-qn-qingse
# Optional extra or cloned voices shown in the page selector.
# MINIMAX_TTS_VOICES_JSON={"my_voice":{"label":"我的音色","description":"自定义克隆音色","voiceId":"your-voice-id"}}
# Optional, dedicated paid key for scripts/generate_minimax_action_videos.mjs.
# MINIMAX_VIDEO_API_KEY=
PORT=3000

# Optional local long-term memory path. Defaults to ./data/companion-memory.json.
# MEMORY_FILE=/absolute/path/to/companion-memory.json
