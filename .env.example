# Never expose this key in browser code.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Or use MiniMax for both text and speech.
# AI_PROVIDER=minimax
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 中国大陆低延迟 TTS 入口；海外部署可改回 https://api.minimaxi.com/v1
# MINIMAX_TTS_BASE_URL=https://api-bj.minimaxi.com/v1
# MiniMax-M3 使用 reasoning_split 隔离隐藏推理，避免思考文本进入朗读正文
# MINIMAX_TEXT_MODEL=MiniMax-M3
# 默认不发起启动文案请求；仅长期稳定部署确认能收益时显式开启。
# MINIMAX_CHAT_WARMUP=0
# 可选：上游响应头超过该毫秒数时发起一次竞速请求；0 表示关闭。
# 慢请求可能产生一次额外 API 计费，确认可接受后再设为 2500。
# MINIMAX_HEDGE_DELAY_MS=0
# MINIMAX_TTS_MODEL=speech-2.8-turbo
# MINIMAX_TTS_VOICE=female-tianmei
# MINIMAX_TTS_VOICE=male-qn-qingse
# Optional extra or cloned voices shown in the page selector.
# MINIMAX_TTS_VOICES_JSON={"my_voice":{"label":"我的音色","description":"自定义克隆音色","voiceId":"your-voice-id"}}
# Optional, dedicated paid key for scripts/generate_minimax_action_videos.mjs.
# MINIMAX_VIDEO_API_KEY=
PORT=3000

# Speech recognition. local_sherpa uses this repository's standalone sherpa-onnx service.
ASR_PROVIDER=local_sherpa
LOCAL_ASR_BASE_URL=http://127.0.0.1:8010
LOCAL_ASR_PATH=/api/asr/transcribe
# Fall back to browser Web Speech when the local service is unavailable.
LOCAL_ASR_BROWSER_FALLBACK=1
# Optional settings used by scripts/start_local_asr.sh.
# SENSEVOICE_MODEL_DIR=/absolute/path/to/sensevoice
# LOCAL_ASR_THREADS=2
# LOCAL_ASR_PORT=8010

# Optional local long-term memory path. Defaults to ./data/companion-memory.json.
# MEMORY_FILE=/absolute/path/to/companion-memory.json

# Optional anonymous latency sample path. Defaults to ./data/chat-latency-samples.json.
# The file contains bounded timings and a limited first-speech type only, never chat content or IDs.
# LATENCY_SAMPLE_FILE=/absolute/path/to/chat-latency-samples.json

# 本地克隆语音；不改变 AI_PROVIDER 的聊天模型
# TTS_PROVIDER=qwen_local
# LOCAL_TTS_BASE_URL=http://127.0.0.1:8020
