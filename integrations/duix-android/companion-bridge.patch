+package ai.guiji.duix.test.companion
+
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.util.concurrent.TimeUnit
+
+data class CompanionReply(val text: String, val emotion: String, val action: String = "idle")
+
+class CompanionApiClient(private val baseUrl: String) {
+    private val jsonType = "application/json; charset=utf-8".toMediaType()
+    private val client = OkHttpClient.Builder()
+        .connectTimeout(5, TimeUnit.SECONDS)
+        .readTimeout(60, TimeUnit.SECONDS)
+        .writeTimeout(15, TimeUnit.SECONDS)
+        .build()
+    private val history = mutableListOf<Pair<String, String>>()
+
+    fun chat(message: String): CompanionReply {
+        val recentHistory = JSONArray()
+        synchronized(history) {
+            history.takeLast(20).forEach { (role, content) ->
+                recentHistory.put(JSONObject().put("role", role).put("content", content))
+            }
+        }
+        val payload = JSONObject()
+            .put("message", message)
+            .put("userId", "duix-android-poc")
+            .put("history", recentHistory)
+        val request = Request.Builder()
+            .url("$baseUrl/api/chat")
+            .post(payload.toString().toRequestBody(jsonType))
+            .build()
+        client.newCall(request).execute().use { response ->
+            val raw = response.body?.string().orEmpty()
+            if (!response.isSuccessful) throw IllegalStateException(readError(raw, "对话请求失败 (${response.code})"))
+            val result = JSONObject(raw)
+            val reply = result.optString("reply").trim()
+            if (reply.isEmpty()) throw IllegalStateException("后端没有返回回复")
+            synchronized(history) {
+                history += "user" to message
+                history += "assistant" to reply
+                while (history.size > 20) history.removeAt(0)
+            }
+            return CompanionReply(
+                reply,
+                result.optString("emotion", "calm"),
+                result.optString("action", "idle")
+            )
+        }
+    }
+
+    fun streamChat(message: String, onSentence: (String, String) -> Unit): CompanionReply {
+        val recentHistory = JSONArray()
+        synchronized(history) {
+            history.takeLast(20).forEach { (role, content) ->
+                recentHistory.put(JSONObject().put("role", role).put("content", content))
+            }
+        }
+        val payload = JSONObject()
+            .put("message", message)
+            .put("userId", "duix-android-poc")
+            .put("history", recentHistory)
+        val request = Request.Builder()
+            .url("$baseUrl/api/chat/stream")
+            .post(payload.toString().toRequestBody(jsonType))
+            .build()
+        client.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) {
+                val raw = response.body?.string().orEmpty()
+                throw IllegalStateException(readError(raw, "流式对话请求失败 (${response.code})"))
+            }
+            val source = response.body?.source() ?: throw IllegalStateException("后端没有返回流式回复")
+            var event = "message"
+            val data = StringBuilder()
+            var emotion = "calm"
+            var action = "idle"
+            var streamedText = ""
+            var finalReply: CompanionReply? = null
+
+            fun consumeEvent() {
+                if (data.isEmpty()) return
+                val json = JSONObject(data.toString())
+                when (event) {
+                    "meta" -> {
+                        emotion = json.optString("emotion", emotion)
+                        action = json.optString("action", action)
+                    }
+                    "sentence" -> {
+                        val sentence = json.optString("text").trim()
+                        if (sentence.isNotEmpty()) {
+                            streamedText += sentence
+                            onSentence(sentence, emotion)
+                        }
+                    }
+                    "done" -> {
+                        emotion = json.optString("emotion", emotion)
+                        action = json.optString("action", action)
+                        val reply = json.optString("reply", streamedText).trim().ifEmpty { streamedText }
+                        finalReply = CompanionReply(reply, emotion, action)
+                    }
+                    "error" -> throw IllegalStateException(json.optString("error", "流式回答中断"))
+                }
+            }
+
+            while (true) {
+                val line = source.readUtf8Line() ?: break
+                if (line.isEmpty()) {
+                    consumeEvent()
+                    event = "message"
+                    data.setLength(0)
+                } else if (line.startsWith("event:")) {
+                    event = line.substringAfter(':').trim()
+                } else if (line.startsWith("data:")) {
+                    if (data.isNotEmpty()) data.append('\n')
+                    data.append(line.substringAfter(':').trim())
+                }
+            }
+            consumeEvent()
+            val reply = finalReply ?: CompanionReply(streamedText, emotion, action)
+            if (reply.text.isBlank()) throw IllegalStateException("后端没有返回回复")
+            synchronized(history) {
+                history += "user" to message
+                history += "assistant" to reply.text
+                while (history.size > 20) history.removeAt(0)
+            }
+            return reply
+        }
+    }
+
+    fun synthesize(reply: CompanionReply, output: File): File {
+        val payload = JSONObject().put("text", reply.text).put("emotion", reply.emotion)
+        val request = Request.Builder()
+            .url("$baseUrl/api/speech")
+            .post(payload.toString().toRequestBody(jsonType))
+            .build()
+        client.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) {
+                val raw = response.body?.string().orEmpty()
+                throw IllegalStateException(readError(raw, "语音请求失败 (${response.code})"))
+            }
+            output.parentFile?.mkdirs()
+            response.body?.byteStream()?.use { input -> output.outputStream().use(input::copyTo) }
+                ?: throw IllegalStateException("后端没有返回语音")
+            if (output.length() < 44) throw IllegalStateException("返回的 WAV 文件无效")
+            return output
+        }
+    }
+
+    private fun readError(raw: String, fallback: String): String = try {
+        JSONObject(raw).optString("error", fallback)
+    } catch (_: Exception) {
+        fallback
+    }
+}
