+    private fun readSmoothedPcm(wavFile: File): ByteArray {
+        val wav = wavFile.readBytes()
+        if (wav.size < 12 || asciiChunkId(wav, 0) != "RIFF" || asciiChunkId(wav, 8) != "WAVE") {
+            throw IllegalStateException("返回的 WAV 文件无效")
+        }
+        var offset = 12
+        var formatValid = false
+        var pcm: ByteArray? = null
+        while (offset + 8 <= wav.size) {
+            val chunkId = asciiChunkId(wav, offset)
+            val chunkSize = readUInt32Le(wav, offset + 4)
+            val dataOffset = offset + 8
+            val dataEnd = dataOffset.toLong() + chunkSize
+            if (dataEnd > wav.size || dataEnd > Int.MAX_VALUE) {
+                throw IllegalStateException("WAV 数据块长度无效")
+            }
+            if (chunkId == "fmt ") {
+                if (chunkSize < 16L) throw IllegalStateException("WAV fmt 数据块无效")
+                val audioFormat = readUInt16Le(wav, dataOffset)
+                val channels = readUInt16Le(wav, dataOffset + 2)
+                val sampleRate = readUInt32Le(wav, dataOffset + 4)
+                val bitsPerSample = readUInt16Le(wav, dataOffset + 14)
+                formatValid = audioFormat == 1 && channels == 1 && sampleRate == 16_000L && bitsPerSample == 16
+            } else if (chunkId == "data") {
+                val evenSize = chunkSize.toInt() and -2
+                pcm = wav.copyOfRange(dataOffset, dataOffset + evenSize)
+                Log.i(TAG, "COMPANION_WAV_DATA_OFFSET=$dataOffset")
+            }
+            offset = dataEnd.toInt() + (chunkSize.toInt() and 1)
+        }
+        if (!formatValid) throw IllegalStateException("WAV 必须是 16kHz 单声道 16-bit PCM")
+        val audio = pcm ?: throw IllegalStateException("WAV 缺少 data 数据块")
+        val sampleCount = audio.size / 2
+        val fadeSamples = minOf(160, sampleCount / 4)
+        for (index in 0 until fadeSamples) {
+            scalePcmSample(audio, index, index.toFloat() / fadeSamples)
+            scalePcmSample(audio, sampleCount - 1 - index, index.toFloat() / fadeSamples)
+        }
+        return audio + ByteArray(960)
+    }
+
+    private fun asciiChunkId(data: ByteArray, offset: Int): String {
+        if (offset < 0 || offset + 4 > data.size) return ""
+        return String(data, offset, 4, Charsets.US_ASCII)
+    }
+
+    private fun readUInt16Le(data: ByteArray, offset: Int): Int {
+        if (offset < 0 || offset + 2 > data.size) throw IllegalStateException("WAV 头部不完整")
+        return (data[offset].toInt() and 0xff) or ((data[offset + 1].toInt() and 0xff) shl 8)
+    }
+
+    private fun readUInt32Le(data: ByteArray, offset: Int): Long {
+        if (offset < 0 || offset + 4 > data.size) throw IllegalStateException("WAV 头部不完整")
+        return (data[offset].toLong() and 0xff) or
+            ((data[offset + 1].toLong() and 0xff) shl 8) or
+            ((data[offset + 2].toLong() and 0xff) shl 16) or
+            ((data[offset + 3].toLong() and 0xff) shl 24)
+    }
+
+    private fun scalePcmSample(pcm: ByteArray, sampleIndex: Int, factor: Float) {
+        val offset = sampleIndex * 2
+        val value = ((pcm[offset].toInt() and 0xff) or (pcm[offset + 1].toInt() shl 8)).toShort()
+        val scaled = (value * factor).toInt().toShort().toInt()
+        pcm[offset] = (scaled and 0xff).toByte()
+        pcm[offset + 1] = ((scaled shr 8) and 0xff).toByte()
+    }
+
+    private fun waitForCompanionPlayback(generation: Int) {
+        synchronized(companionPlaybackLock) {
+            val deadline = SystemClock.elapsedRealtime() + 120_000L
+            while (!companionPlaybackFinished && generation == companionGeneration.get()) {
+                val remaining = deadline - SystemClock.elapsedRealtime()
+                if (remaining <= 0L) break
+                companionPlaybackLock.wait(minOf(remaining, 1_000L))
+            }
+        }
+    }
+
+    private fun cancelCompanionPipeline() {
+        companionGeneration.incrementAndGet()
+        companionLogFirstAudioStart = false
+        companionPendingAction = "idle"
+        companionPendingActionGeneration = -1
+        companionActionTriggeredGeneration.set(-1)
+        duix?.stopAudio()
+        signalCompanionPlaybackFinished()
+        binding.btnRecord.isEnabled = true
+        binding.btnPlayWAV.isEnabled = true
+    }
+
+    private fun signalCompanionPlaybackFinished() {
+        synchronized(companionPlaybackLock) {
+            companionPlaybackFinished = true
+            companionPlaybackLock.notifyAll()
+        }
+    }
+
+    private fun triggerCompanionMotionIfAvailable() {
+        val generation = companionGeneration.get()
+        if (companionPendingActionGeneration != generation) return
+        if (!companionActionTriggeredGeneration.compareAndSet(-1, generation)) return
+        val action = companionPendingAction
+        if (action == "idle") {
+            Log.i(TAG, "COMPANION_ACTION_SKIPPED=idle")
+            return
+        }
+        val availableNames = mModelInfo?.motionRegions
+            ?.mapNotNull { motion -> motion.name?.takeIf { it.isNotBlank() && it != "unknown" } }
+            .orEmpty()
+        if (availableNames.isEmpty()) {
+            Log.i(TAG, "COMPANION_ACTION_SKIPPED=no_motion_regions action=$action")
+            return
+        }
+        val aliases = companionActionAliases[action].orEmpty() + action
+        val normalizedAliases = aliases.map(::normalizeMotionName).filter { it.isNotEmpty() }
+        val matched = availableNames.firstOrNull { name ->
+            val normalizedName = normalizeMotionName(name)
+            normalizedAliases.any { alias -> normalizedName == alias }
+        } ?: availableNames.firstOrNull { name ->
+            val normalizedName = normalizeMotionName(name)
+            normalizedAliases.any { alias ->
+                alias.length >= 3 && (normalizedName.contains(alias) || alias.contains(normalizedName))
+            }
+        }
+        if (matched == null) {
+            Log.i(TAG, "COMPANION_ACTION_SKIPPED=no_match action=$action available=$availableNames")
+            return
+        }
+        Log.i(TAG, "COMPANION_ACTION_MATCHED action=$action motion=$matched")
+        duix?.startMotion(matched, true)
+    }
+
+    private fun normalizeMotionName(value: String): String = value
+        .lowercase()
+        .replace(Regex("[\\s_\\-]+"), "")
+
+    private val companionActionAliases = mapOf(
+        "wave_approval" to listOf("wave", "waving", "greeting", "hello", "挥手", "招手", "问候"),
+        "clap" to listOf("clap", "clapping", "applause", "鼓掌", "拍手"),
+        "cheer" to listOf("cheer", "celebrate", "celebration", "欢呼", "庆祝", "加油"),
+        "bow" to listOf("bow", "鞠躬", "行礼"),
+        "shy" to listOf("shy", "bashful", "害羞", "脸红"),
+        "thinking" to listOf("think", "thinking", "思考", "想一想"),
+        "surprise" to listOf("surprise", "surprised", "惊讶", "吃惊"),
+        "caring" to listOf("care", "caring", "comfort", "关心", "安慰"),
+        "shrug" to listOf("shrug", "耸肩"),
+        "cross" to listOf("cross", "reject", "refuse", "交叉", "拒绝"),
+        "confident_arms_crossed" to listOf("armscrossed", "crossedarms", "confident", "抱胸", "自信"),
+        "happy" to listOf("happy", "smile", "开心", "微笑"),
+        "smile" to listOf("smile", "happy", "微笑", "开心")
+    )
+
